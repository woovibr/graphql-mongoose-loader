{
  "name": "@woovi/graphql-mongoose-loader",
  "description": "GraphQL Mongoose Loader helpers",
  "version": "6.0.1",
  "author": {
    "name": "Entria",
    "email": "dev@woovi.com.br",
    "url": "https://github.com/woovi"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@microsoft/api-extractor": "^7.60.1",
    "@rslib/core": "^1.0.7",
    "@types/node": "^26.6.6",
    "dataloader": "2.2.3",
    "graphql": "17.1.0",
    "graphql-relay": "0.11.0",
    "lint-staged": "17.6.1",
    "mongodb-memory-server": "11.3.0",
    "mongoose": "9.12.3",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "uuid": "^14.0.3",
    "vitest": "^5.1.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/woovibr/graphql-mongoose-loader",
  "keywords": [
    "graphql",
    "loader",
    "mongoose"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "pnpm prettier --write",
      "eslint --config eslint.config.js --fix"
    ],
    "*.yml": [
      "prettier --write"
    ]
  },
  "main": "./dist/index.cjs",
  "peerDependencies": {
    "graphql": "*",
    "graphql-relay": "*",
    "mongoose": "*"
  },
  "pre-commit": "lint:staged",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woovibr/graphql-mongoose-loader"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "lint": "eslint src/**",
    "lint:staged": "lint-staged",
    "precommit": "pnpm lint:staged",
    "prepare": "npm run build",
    "prepublish": "npm run build",
    "release:major": "npm version major && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:patch": "npm version patch && git push --follow-tags",
    "test": "vitest"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@12.21.0"
}
