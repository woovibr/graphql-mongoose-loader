{
  "compilerOptions": {
    "lib": ["ES2021"],
    "rootDir": "./src",
    "types": ["node"],
    "module": "ESNext",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  "exclude": ["src/__tests__"]
}
